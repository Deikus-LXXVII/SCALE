{
  "schema_version": 1,
  "id": "scale.memora.memory-plane",
  "status": "proposed",
  "description": "Optional fail-closed local Memora runtime memory/index for SCALE candidates.",
  "source": {
    "repository": "https://github.com/agentic-box/memora",
    "license": "MIT"
  },
  "source_revision": null,
  "activation": "disabled_until_pinned",
  "transport": "stdio",
  "entry": "memora-server",
  "args": [
    "--no-graph"
  ],
  "authority": "scale-git",
  "sync_policy": "manual-export",
  "storage": {
    "kind": "sqlite",
    "scope": "local",
    "default": true,
    "network_access": false,
    "path": "~/.local/share/memora/memory.sqlite3"
  },
  "network": {
    "public_http": false,
    "cloud": false
  },
  "llm": {
    "enabled": false,
    "embeddings": false,
    "deduplication": false,
    "chat": false
  },
  "policy": {
    "allow_any_tag": false,
    "forbidden_environment": [
      "MEMORA_ALLOW_ANY_TAG"
    ],
    "destructive_tools": "forbidden_by_default",
    "memory_is_untrusted": true,
    "normal_agents": "read_only"
  },
  "cold_context": {
    "required_before_inactive_context_action": true,
    "fail_closed": true,
    "results_untrusted": true,
    "normal_agents": "read_only",
    "on_unavailable_or_insufficient_provenance": "block_or_escalate_native",
    "retrieval_tools": [
      "memory_digest",
      "memory_semantic_search",
      "memory_hybrid_search",
      "memory_get",
      "memory_stats"
    ],
    "required_provenance": [
      "source",
      "evidence",
      "compatibility",
      "validated_on",
      "review_after",
      "source_commit",
      "source_path",
      "content_hash",
      "project",
      "scope",
      "sensitivity",
      "status",
      "validation",
      "expires_at",
      "sync_policy"
    ]
  },
  "limits": {
    "retrieval": {
      "max_results": 20,
      "max_query_chars": 512,
      "max_payload_bytes": 32768
    },
    "curator_writes": {
      "max_candidates": 3,
      "max_content_bytes": 4096,
      "max_tags": 8,
      "max_provenance_bytes": 2048,
      "max_total_request_bytes": 8192
    },
    "call_timeout_ms": 3000
  },
  "capabilities": {
    "normal_agents": {
      "read": [
        "memory_digest",
        "memory_semantic_search",
        "memory_hybrid_search",
        "memory_get",
        "memory_stats"
      ]
    },
    "curator": {
      "candidate_write": [
        "memory_create",
        "memory_update",
        "memory_absorb",
        "memory_store_document"
      ]
    },
    "validators": {
      "read": [
        "memory_digest",
        "memory_semantic_search",
        "memory_hybrid_search",
        "memory_get",
        "memory_stats"
      ]
    },
    "forbidden": [
      "memory_delete",
      "memory_delete_batch",
      "memory_merge",
      "memory_import",
      "memory_create_batch"
    ],
    "destructive_boundary": {
      "delete": "forbidden",
      "merge": "forbidden",
      "import": "forbidden",
      "bulk": "forbidden",
      "filesystem": "forbidden"
    }
  },
  "curator_policy": {
    "role": "scale_memora_curator",
    "activation": "explicit_invocation_only",
    "automatic_activation": false,
    "route": "codex-native",
    "binding": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high",
      "sandbox_mode": "read-only"
    },
    "task_gate": {
      "required_task_status": "success",
      "requires_durable_observation": true,
      "requires_verified_evidence": true,
      "forbidden_task_status": [
        "failed",
        "partial",
        "unknown"
      ]
    },
    "candidate_status": "candidate",
    "validation_status": "unvalidated",
    "promotion": "manual_scale_git_only",
    "provenance_gate": {
      "required_validation": "passed",
      "allowed_status": [
        "candidate",
        "curated"
      ]
    },
    "required_provenance": [
      "source",
      "evidence",
      "compatibility",
      "validated_on",
      "review_after",
      "source_commit",
      "source_path",
      "content_hash",
      "project",
      "scope",
      "sensitivity",
      "status",
      "validation",
      "expires_at",
      "sync_policy"
    ],
    "tag_allowlist": [
      "scale:project:<slug>",
      "scale:scope:global|project|agent|session",
      "scale:sensitivity:public|internal|confidential|restricted",
      "scale:status:candidate|curated|deprecated",
      "scale:validation:unvalidated|passed|failed|stale",
      "scale:source:git|operator"
    ],
    "candidate_write_tools": [
      "memory_create",
      "memory_update",
      "memory_absorb",
      "memory_store_document"
    ],
    "forbidden_operations": [
      "memory_delete",
      "memory_delete_batch",
      "memory_merge",
      "memory_import",
      "memory_create_batch",
      "promotion",
      "git_mutation",
      "direct_sqlite_write",
      "direct_api_write"
    ],
    "forbidden_content": [
      "secrets",
      "credentials",
      "pii",
      "audio",
      "transcripts"
    ],
    "telemetry": {
      "fields": [
        "decision",
        "reason",
        "task_id",
        "candidate_id",
        "curator_role",
        "binding"
      ],
      "content_free": true,
      "evidence_free": true
    }
  },
  "provenance": {
    "required_fields": [
      "source",
      "evidence",
      "compatibility",
      "validated_on",
      "review_after",
      "source_commit",
      "source_path",
      "content_hash",
      "project",
      "scope",
      "sensitivity",
      "status",
      "validation",
      "expires_at",
      "sync_policy"
    ]
  },
  "tags": {
    "allowlist": [
      "scale:project:<slug>",
      "scale:scope:global|project|agent|session",
      "scale:sensitivity:public|internal|confidential|restricted",
      "scale:status:candidate|curated|deprecated",
      "scale:validation:unvalidated|passed|failed|stale",
      "scale:source:git|operator"
    ]
  },
  "model_policy": {
    "direct_api": false,
    "route": "scale-opencode-dispatcher",
    "native_fallback": "scale-orchestrator"
  },
  "runtime_gateway": {
    "server_name": "scale_memora_curator",
    "source": "scripts/scale-memora-curator-gateway.mjs",
    "transport": "stdio",
    "activation": "explicit_invocation_only",
    "source_revision_env": "SCALE_MEMORA_SOURCE_REVISION",
    "enable_env": "SCALE_MEMORA_CURATOR_ENABLE",
    "requires_source_revision_match": true,
    "upstream": {
      "entry": "memora-server",
      "args": ["--no-graph"],
      "entry_env": "SCALE_MEMORA_ENTRY",
      "args_env": "SCALE_MEMORA_ARGS",
      "transport": "stdio",
      "local_only": true,
      "requires_pinned_source_revision": true
    },
    "read_tools": [
      "memory_digest",
      "memory_semantic_search",
      "memory_hybrid_search",
      "memory_get",
      "memory_stats"
    ],
    "candidate_write_tools": [
      "memory_create",
      "memory_update",
      "memory_absorb",
      "memory_store_document"
    ],
    "upstream_tag_translation": {
      "technical_tag": "note",
      "preserve_original_scale_tags_in_metadata": true
    },
    "closed_until_candidate_semantics_proven": [
      "memory_absorb",
      "memory_store_document"
    ],
    "read_only_gateway_unchanged": true,
    "forbidden": [
      "direct_sqlite",
      "direct_http",
      "destructive_tools",
      "promotion",
      "git_mutation"
    ]
  }
}
