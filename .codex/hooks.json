{
  "description": "Refresh the S.C.A.L.E. knowledge clone when a trusted Codex session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/scale-plugin-session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Refreshing S.C.A.L.E. knowledge",
            "additionalContextLimit": 800
          }
        ]
      }
    ]
  }
}
