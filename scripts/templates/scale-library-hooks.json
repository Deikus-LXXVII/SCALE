{
  "description": "Refresh the connected S.C.A.L.E. library at Codex session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/scale-library-src/scripts/scale-plugin-session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Refreshing S.C.A.L.E. knowledge",
            "additionalContextLimit": 800
          }
        ]
      }
    ]
  }
}
